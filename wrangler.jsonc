{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mymacros",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // better-auth needs node:crypto / node:buffer
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // SPA: unknown paths fall through to index.html so client routing works.
    // The asset directory is supplied by the Vite plugin — don't set it here.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",

    // Without this, the asset router answers HTML *navigations* to unmatched
    // paths with index.html before the Worker ever runs — and the Google
    // OAuth callback is a top-level navigation. The browser landed on
    // /api/auth/callback/google and got the SPA back, so better-auth never
    // saw the code, no session was created, and the app bounced straight back
    // to sign-in with no error anywhere. fetch()-based /api calls were
    // unaffected because they send Accept: application/json rather than
    // text/html, which is also why curl probes of the same URL all passed.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },

  // The app is served from its custom domain only. Cloudflare creates the DNS
  // record in the debrief.run zone and issues the certificate itself.
  //
  // workers.dev is off deliberately, and specifically because of this
  // deployment's rpID: a passkey's rpID must be the origin's host or a parent
  // of it, and `debrief.run` is not a parent of `*.workers.dev`, so passkeys
  // would refuse there. It is not a general objection to workers.dev — a
  // self-hoster who sets no PASSKEY_RP_ID gets the hostname as its own rpID
  // and passkeys work there with no domain at all.
  //
  // Declared here rather than clicked in the dashboard so Workers Builds
  // reapplies it on every deploy instead of drifting away from it (#7).
  "routes": [{ "pattern": "fuel.debrief.run", "custom_domain": true }],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mymacros-db",
      // The real database, created in Session B2. Not a secret — a database
      // id is useless without credentials for the account that owns it.
      // Local dev (miniflare) ignores this value entirely.
      "database_id": "4cf59eaf-8cfe-4c44-b599-d038018fcaed",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public, non-secret config — these are the PRODUCTION values. Local dev
    // overrides them from .dev.vars, which takes precedence over this block,
    // so there's no second environment to keep in sync. Secrets live in
    // .dev.vars locally and `wrangler secret put` remotely — see
    // .dev.vars.example.
    "APP_URL": "https://fuel.debrief.run",

    // Passkeys bind to this domain, not the app's own hostname, so one
    // credential covers every *.debrief.run app as they appear (#34).
    // Changing it later forces everyone to re-enrol — see src/worker/auth.ts.
    "PASSKEY_RP_ID": "debrief.run"
  }
}
