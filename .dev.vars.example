# Local secrets and local overrides for `vite dev` / `wrangler dev`.
# Copy to `.dev.vars` (gitignored).
#
# Values here take precedence over the `vars` block in wrangler.jsonc, which
# holds the PRODUCTION values — that's how one config serves both without a
# second wrangler environment. Secrets are set remotely with
# `wrangler secret put <NAME>` — see NEXT-STEPS.md (Session B2).

# Local overrides of the production vars. Without these you'd be running the
# dev server as though it were fuel.debrief.run, and both Google's redirect
# and the passkey rpID would refuse.
APP_URL="http://localhost:5173"
PASSKEY_RP_ID="localhost"


# Signs session cookies. Any long random string locally:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me"

# Google OAuth — created in Session B2 (Google Cloud Console → Credentials →
# OAuth client ID → Web application). Leave empty and Google sign-in stays
# disabled; passkeys work without it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Claude vision/text → macros. Not called until M2.
ANTHROPIC_API_KEY=""
